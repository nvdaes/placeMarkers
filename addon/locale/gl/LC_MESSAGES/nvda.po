msgstr "Procurar &anterior"

#. Translators: An action in the Search group of the Specific search dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:416
msgid "&Don't search"
msgstr "&Non procurar"

#. Translators: Message presented when place markers have been copied.
#: addon\globalPlugins\placeMarkers\__init__.py:504
msgid "Place markers copied"
msgstr "Marcadores copiados"

#. Translators: label of error dialog shown when cannot copy placeMarkers folder.
#: addon\globalPlugins\placeMarkers\__init__.py:510
#: addon\globalPlugins\placeMarkers\__init__.py:531
msgid "Folder not copied"
msgstr "Cartafol non copiado"

#. Translators: title of error dialog shown when cannot copy placeMarkers folder.
#: addon\globalPlugins\placeMarkers\__init__.py:512
#: addon\globalPlugins\placeMarkers\__init__.py:533
msgid "Copy Error"
msgstr "Erro da Copia"

#. Translators: Message presented when place markers have been restored.
#: addon\globalPlugins\placeMarkers\__init__.py:525
msgid "Place markers restored"
msgstr "Marcadores restaurados"

#. Translators: The title of the Notes dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:543
msgid "Notes"
msgstr "Notas"

#. Translators: The label of a list box in the Notes dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:548
msgid "&Bookmarks"
msgstr "&Marcas"

#. Translators: The label of an edit box in the Notes dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:560
msgid "Not&e:"
msgstr "Not&a:"

#. Translators: The label for a button in the Notes dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:570
msgid "&Save note"
msgstr "&Gardar nota"

#. Translators: The label for a button in the Notes dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:573
msgid "&Delete..."
msgstr "&Borrar..."

#. Translators: The confirmation prompt displayed when the user requests to delete a bookmark.
#: addon\globalPlugins\placeMarkers\__init__.py:608
msgid "This bookmark will be permanently deleted. This action cannot be undone."
msgstr "Esta marca borrarase permanentemente. Esta ación non pode desfacerse."

#. Translators: The message presented when all bookmarks have been deleted from the Notes dialog.
#. Translators: message presented when the current document doesn't contain bookmarks.
#: addon\globalPlugins\placeMarkers\__init__.py:639
#: addon\globalPlugins\placeMarkers\__init__.py:1081
#: addon\globalPlugins\placeMarkers\__init__.py:1181
#: addon\globalPlugins\placeMarkers\__init__.py:1220
msgid "No bookmarks"
msgstr "Non hai marcas"

#. Translators: The title of the warning dialog when all bookmarks have been deleted.
#: addon\globalPlugins\placeMarkers\__init__.py:641
msgid "Bookmarks deleted"
msgstr "Marcas borradas"

#. Translators: The title of the Copy dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:655
msgid "Copy place markers"
msgstr "Copiar marcadores"

#. Translators: An informational message displayed in the Copy dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:661
msgid "Select a folder to save a backup of your current place markers."
msgstr "Seleciona un cartafol para gardar una copia de seguridade das actuáis marcas."

#. Translators: The label of a grouping with controls to select the destination directory in the Copy dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:665
msgid "directory for backup:"
msgstr "directorio para copia de seguridade:"

#. Translators: The title of the dialog to browse for the destination directory when copying place markers.
#: addon\globalPlugins\placeMarkers\__init__.py:675
msgid "Select directory to copy"
msgstr "Seleciona o directorio para copiar"

#. Translators: The title of the Set default folder dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:721
msgid "Set default folder for place markers"
msgstr ""

#. Translators: An informational message displayed in the Set default folder dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:727
msgid "Select the folder where your place markers will be searched."
msgstr ""

#. Translators: The label of a grouping with controls to select the folder in the Set default folder dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:731
msgid "default directory for place markers:"
msgstr ""

#. Translators: The title of the dialog to browse for the default directory for place markers.
#: addon\globalPlugins\placeMarkers\__init__.py:741
msgid "Select default directory"
msgstr ""

#. Translators: The title of the Restore dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:805
msgid "Restore place markers"
msgstr "Restaurar marcadores"

#. Translators: An informational message displayed in the Restore dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:811
msgid "Select a folder to restore a backup of your previous copied place markers."
msgstr "Seleciona un cartafol para restaurar una copia de seguridade das túas marcas copiadas anteriormente."

#. Translators: The label of a grouping with controls to select the destination directory in Restore dialog.
#: addon\globalPlugins\placeMarkers\__init__.py:815
msgid "directory containing backup:"
msgstr "directorio que contén a copia de seguridade:"

#. Translators: The title of the dialog to browse for the destination directory when restoring place markers.
#: addon\globalPlugins\placeMarkers\__init__.py:825
msgid "Select directory to restore"
msgstr "Selecciona directorio a restaurar"

#. Translators: the name of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:893
msgid "P&lace markers"
msgstr "P&lace markers"

#. Translators: the tooltip text for addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:895
msgid "Bookmarks and Search menu"
msgstr "Menú Marcas e Buscar"

#. Translators: the name for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:900
msgid "&Specific search folder"
msgstr "Cartafol Busca &Específica"

#. Translators: the tooltip text for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:902
msgid "Opens the specific search folder"
msgstr "Abre o cartafol busca específica"

#. Translators: the name for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:908
msgid "&Bookmarks folder"
msgstr "Cartafol &Marcas"

#. Translators: the tooltip text for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:910
msgid "Opens the bookmarks folder"
msgstr "Abre o cartafol marcas"

#. Translators: the name for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:916
msgid "&Copy placeMarkers folder..."
msgstr "&Copiar cartafol marcas..."

#. Translators: the tooltip text for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:918
msgid "Backup of place markers"
msgstr "Copia de seguridade de marcas"

#. Translators: the name for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:924
msgid "R&estore place markers..."
msgstr "R&estaurar marcas..."

#. Translators: the tooltip text for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:926
msgid "Restore previously saved place markers"
msgstr "Restaurar marcas gardadas anteriormente"

#. Translators: the name for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:932
msgid "Set &default place markers folder..."
msgstr ""

#. Translators: the tooltip text for an item of addon submenu.
#: addon\globalPlugins\placeMarkers\__init__.py:934
msgid "Sets default folder for place markers"
msgstr ""

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:949
msgid "Opens the specific search folder."
msgstr "Abre o cartafol procura específica."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:959
msgid "Opens the bookmarks folder."
msgstr "Abre o cartafol marcadores."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:972
#, python-format
msgid "Activates the Copy dialog of %s."
msgstr "Activa o diálogo Copiar de %s."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:985
#, python-format
msgid "Activates the Restore dialog of %s."
msgstr "Activa o diálogo Restaurar de %s."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:998
#, python-format
msgid "Activates the Set default folder dialog of %s."
msgstr ""

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1005
msgid "finds a text string from the current cursor position for a specific document."
msgstr "atopa unha secuencia de texto dende a posición actual do cursor dun documento específico."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1031
msgid "finds the next occurrence of the last text searched for any specific document."
msgstr "atopar a próxima ocorrencia do último texto buscado en calquera documento específico."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1055
msgid "finds the previous occurrence of the last text searched for any specific document."
msgstr "atopar a ocorrencia anterior do último texto buscado en calquera documento específico."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1091
msgid "Show the Notes dialog for a specific document."
msgstr "Amosa o diálogo Notas para un documento específico."

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1110
msgid "Saves the current position as a bookmark."
msgstr "Garda a posición actual como unha marca."

#. Translators: message presented when a position is saved as a bookmark.
#: addon\globalPlugins\placeMarkers\__init__.py:1154
#, python-format
msgid "Saved position at character %d"
msgstr "Posición gardada: carácter %d"

#. Translators: message presented when a bookmark cannot be saved.
#: addon\globalPlugins\placeMarkers\__init__.py:1160
msgid "Cannot save bookmark"
msgstr "Non se poido gardar a marca"

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1166
msgid "Deletes the current bookmark."
msgstr "Elimina a marca actual."

#. Translators: message presented when the current document has bookmarks, but none is selected.
#: addon\globalPlugins\placeMarkers\__init__.py:1195
msgid "No bookmark selected"
msgstr "Non hai marca seleccionada"

#. Translators: message presented when a bookmark is deleted.
#: addon\globalPlugins\placeMarkers\__init__.py:1210
msgid "Bookmark deleted"
msgstr "Marca eliminada"

#. Translators: message presented when cannot delete a bookmark.
#: addon\globalPlugins\placeMarkers\__init__.py:1228
msgid "Cannot delete bookmark"
msgstr "Non se pode eliminar a marca"

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1233
msgid "Moves to the next bookmark."
msgstr "Móvese á seguinte marca."

#. Translators: message presented when trying to select a bookmark, but none is found.
#: addon\globalPlugins\placeMarkers\__init__.py:1253
#: addon\globalPlugins\placeMarkers\__init__.py:1306
msgid "No bookmarks found"
msgstr "Non se atoparon marcas"

#. Translators: message presented when a bookmark is selected.
#: addon\globalPlugins\placeMarkers\__init__.py:1276
#: addon\globalPlugins\placeMarkers\__init__.py:1329
#, python-format
msgid "Position: character %d"
msgstr "Posición: carácter %d"

#. Translators: message presented when the next bookmark is not found.
#: addon\globalPlugins\placeMarkers\__init__.py:1281
msgid "Next bookmark not found"
msgstr "Non se atopou a seguinte marca"

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1286
msgid "Moves to the previous bookmark."
msgstr "Móvese á  marca anterior."

#. Translators: message presented when the previous bookmark is not found.
#: addon\globalPlugins\placeMarkers\__init__.py:1334
msgid "Previous bookmark not found"
msgstr "Non se atopou a marca anterior"

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1339
msgid "Shows the name of the current file for place markers in browse mode."
msgstr "Amosa o nome do arquivo actual de marcas en modo exploración."

#. Translators: Presented when the current document has positional bookmarks.
#: addon\globalPlugins\placeMarkers\__init__.py:1354
msgid "Has bookmarks."
msgstr "Ten marcas."

#. Translators: Presented when the current document has specific search.
#: addon\globalPlugins\placeMarkers\__init__.py:1357
msgid "Has text for specific search."
msgstr "Ten texto de procura específica."

#. Translators: Presented when the current document has a temporary bookmark.
#: addon\globalPlugins\placeMarkers\__init__.py:1360
msgid "Has temporary bookmark."
msgstr "Ten marca temporal."

#. Translators: Title for a message presented when the file name for place markers is shown in browse mode.
#: addon\globalPlugins\placeMarkers\__init__.py:1364
#, python-format
msgid "%s file"
msgstr "arquivo %s"

#. Translators: message presented in input mode, when a keystroke of an addon script is pressed.
#: addon\globalPlugins\placeMarkers\__init__.py:1371
msgid "Saves the current position as a temporary bookmark."
msgstr "Garda a posición actual coma unha marca temporal."

#. Translators: Message presented when a temporary bookmark is saved.
#: addon\globalPlugins\placeMarkers\__init__.py:1398
#, python-format
msgid "Saved temporary bookmark at position %d"
msgstr "A marca gardouse temporalmente na posición %d"

#. Translators: Message presented in input help mode.
#: addon\globalPlugins\placeMarkers\__init__.py:1405
msgid "Moves to the temporary bookmark for the current document."
msgstr "Móvese cara a marca temporal para o documento actual."

#. Translators: Message presented when a temporary bookmark can't be found.
#: addon\globalPlugins\placeMarkers\__init__.py:1427
msgid "Temporary bookmark not found"
msgstr ""

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Place markers"
msgstr "Place markers"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Add-on for setting place markers on specific virtual documents"
msgstr "Complemento para fixar marcas en documentos virtuais específicos"

